NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
APP_URL=http://localhost:3000
# Set to 1 only when this app is mounted at /recruitment on the Alpha website.
# APP_URL remains an origin only, e.g. https://aws-sbg-alpha.vercel.app (no path).
NEXT_PUBLIC_ALPHA_COMBINED_SITE=
# Server-only. Leave blank to keep email sending disabled. Never use NEXT_PUBLIC_ for these.
ALPHA_GMAIL_APP_PASSWORD=
ALPHA_SUPABASE_SECRET_KEY=
