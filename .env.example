# Copy to .env.local and replace these placeholders with the project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-main-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy anon keys remain supported.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only Skillbuilder administration and profile provisioning.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPERADMIN_EMAIL=
# Optional recruitment mail; leave blank to disable sending.
ALPHA_GMAIL_APP_PASSWORD=
ALPHA_SUPABASE_SECRET_KEY=
