{
  "name": "awslc.alpha.org",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fetch-events": "tsx scripts/fetch-meetup-events.ts",
    "prebuild": "npm run fetch-events",
    "predev": "npm run fetch-events",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify": "eslint src scripts next.config.ts && tsc --noEmit",
    "test:recruitment": "cd src/recruitment && node --experimental-strip-types --test --test-concurrency=2 tests/*.test.mjs",
    "test:browser": "cd src/recruitment && node scripts/browser-tests.mjs",
    "test:ci": "npm run test:integration && npm run test:recruitment",
    "verify:ci": "node src/recruitment/scripts/verify-ci.mjs",
    "db:recruitment:sql": "node scripts/setup-recruitment-db.mjs",
    "test:integration": "node --test scripts/shared-proxy.test.mjs scripts/shared-member-removal.test.mjs scripts/recruitment-setup.test.mjs scripts/section-navigation.test.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-alert-dialog": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "driver.js": "^1.4.0",
    "framer-motion": "^12.34.0",
    "geist": "latest",
    "gsap": "3.15.0",
    "lenis": "^1.3.17",
    "lucide-react": "latest",
    "next": "16.4.5",
    "nodemailer": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "latest",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/eslintrc": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "8.0.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "dotenv": "16.6.1",
    "eslint": "latest",
    "eslint-config-next": "16.4.5",
    "js-yaml": "4.3.2",
    "playwright": "1.63.0",
    "postcss": "latest",
    "prisma": "^7.5.0",
    "scheduler": "0.28.0",
    "tailwindcss": "latest",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
